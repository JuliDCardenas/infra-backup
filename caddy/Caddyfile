evolution.julidcardenas.site {
	# Soporte completo para WebSockets
	reverse_proxy localhost:8082 {
		# Headers necesarios para WebSocket
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Timeout largo para WebSockets (importante para QR)
		transport http {
			read_timeout 300s
			write_timeout 300s
			dial_timeout 30s
		}
	}

	# Headers de seguridad
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		# NO agregar Content-Security-Policy que bloquee WebSockets
	}

	# Logs para debugging
	log {
		output file /var/log/caddy/evolution.log
		format json
	}

	#reverse_proxy localhost:8082
	basic_auth {
		julidcardenas $2a$14$YTr2W00jndtahwohZRdDv.6oXVZrFTbvbK1T91EmBdZpXaz61sPhS
	}
}

